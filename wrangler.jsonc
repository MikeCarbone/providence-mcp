{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
